# GEMINI_API_KEY: Platform-managed secret in AI Studio.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where CampusCircle is hosted (used for OAuth callbacks & links).
APP_URL="http://localhost:3000"

# ==============================================================================
# SUPABASE CONFIGURATION (Required for Auth, PostgreSQL, Storage & Realtime)
# ==============================================================================

# Public Supabase Project URL (exposed to browser via Vite)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# Public Supabase Anon / Publishable Key (exposed to browser; protected by PostgreSQL RLS)
VITE_SUPABASE_ANON_KEY="your-supabase-anon-public-key"

# Server-Only Supabase Service Role Key (NEVER prefix with VITE_; used ONLY in server.ts)
# Required for full account deletion cleanup and server-verified admin checks.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# Optional comma-separated list of institutional email domains automatically eligible
# for verified student status once the user confirms their email via Supabase Auth.
VITE_ALLOWED_COLLEGE_DOMAINS="ac.in,edu.in,edu,annauniv.edu,iitm.ac.in,christuniversity.in,bits-pilani.ac.in,iisc.ac.in,srmist.edu.in,psgtech.ac.in,loyolacollege.edu"
